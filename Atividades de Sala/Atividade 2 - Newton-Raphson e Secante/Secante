# Método da secante:

# Parâmetros iniciais:
P = 20          # Potência fornecida
h = 10          # Coeficiente de transferência de calor por convecção
A = 0.01        # Área da superfície de transferência de calor
T_amb = 300     # Temperatura ambiente
sigma = 5.67e-8 # Constante de Stefan-Boltzmann
epsilon = 0.8   # Emissividade da superfície
T0 = 300        # Temperatura inicial (chute inicial)


tol = 1e-6 # Tolerância para convergência
max_iter = 100 # Número máximo de iterações


def f(T): # Escrever problema como zero de função (f(T) = 0).
    return h * A * (T - T_amb) + epsilon * sigma * A * (T**4 - T_amb**4) - P


# Condições iniciais:
T0 = 400
T1 = 425


for k in range(1, max_iter + 1):

    #Tk+1 = Tk - f(Tk) * ((Tk - Tk-1) / (f(Tk) - f(Tk-1)))
    Tk_novo = T1 - f(T1) * ((T1 - T0) / (f(T1) - f(T0)))

    erro = abs(Tk_novo - T1)

    print(f"Iteração: {k}, Temperatura = {Tk_novo:.6f}, f(Tk) = {f(T1):.6f}, Erro = {erro:.6f}")

    if erro < tol:
        print(f"Temperatura de Equilíbrio encontrada = {Tk_novo}")
        break

    T0 = T1
    T1 = Tk_novo