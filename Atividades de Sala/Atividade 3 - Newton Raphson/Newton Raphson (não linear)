# Newton-Raphson para sistemas não lineares

import numpy as np

# Parâmetros iniciais:
Q = 0.050 # Vazão total em m³/s
g = 9.81  # Aceleração da gravidade em m/s²
max_iter = 100
tol = 1e-8

# Parâmetros Ramo 1:
L1 = 30       # Comprimento em m
D1 = 0.10     # Diâmetro em m
f1 = 0.020    # Fator de atrito
K1 = 1.5      # Coeficiente de perda localizada

# Parâmetros Ramo 2:
L2 = 20.0     # Comprimento em m
D2 = 0.08     # Diâmetro em m
f2 = 0.022    # Fator de atrito
K2 = 1.0      # Coeficiente de perda localizada
Kv = 8.0      # Perda localizada da válvula

# Cálculo das cte's de resistência R1 e R2 em s**2/m**5
R1 = (f1 * (L1/D1) + K1) * (8 / (g * np.pi**2 * D1**4))
R2 = (f2 * (L2/D2) + K2 + Kv) * (8 / (g * np.pi**2 * D2**4))
# np.pi representa o número pi

# Definição das funções dos resíduos Q:
def funcoes_F1_F2(Q1, Q2):
    F1 = Q1 + Q2 - Q
    F2 = (R1 * Q1**2) - (R2 * Q2**2)
    return F1, F2

# Cálculo das derivadas parciais que formam a Matriz Jacobiana
def matriz_jacobiana(Q1, Q2): # Derivadas feitas à mão
    J11 = 1
    J12 = 1
    J21 = 2 * R1 * Q1
    J22 = -2 * R2 * Q2
    return J11, J12, J21, J22


Q1 = 0.030
Q2 = 0.020

for k in range(1, max_iter + 1):

    # Verifica a soma de Q1 e Q2, mede o erro em um instante.
    F1, F2 = funcoes_F1_F2(Q1, Q2)

    # Recalcula os quatro elementos de derivadas parciais usando as vazões do momento.
    J11, J12, J21, J22 = matriz_jacobiana(Q1, Q2)


    # Sistema linearizado: J * [dQ1, dQ2]**T = [-F1, -F2]**T
    # d neste caso é Delta.
    D = J11 * J22 - J12 * J21
    r1 = -F1
    r2 = -F2

    # Regra de Cramer para as correções dQ1 e dQ2:
    dQ1 = (((r1 * J22) - (J12 * r2)) / D)
    dQ2 = (((J11 * r2) - (r1 * J21)) / D)

    print(f"Iteração {k}, Q1 = {Q1:.6}, Q2 = {Q2:.6}, F1 = {F1:.6}, F2 = {F2:.6}, dQ1 = {dQ1:.6}, dQ2 = {dQ2:.6}")

    # Atualização das vazões:
    Q1_novo = Q1 + dQ1
    Q2_novo = Q2 + dQ2

    erro = max(abs(dQ1), abs(dQ2))

    if erro < tol:
        print(f"Convergiu em {k} iterações")
        print(f"Vazões finais:Q1 = {Q1_novo:.6f} m**3/s, Q2 = {Q2_novo:.6f} m**3/s")
        break

    Q1 = Q1_novo
    Q2 = Q2_novo